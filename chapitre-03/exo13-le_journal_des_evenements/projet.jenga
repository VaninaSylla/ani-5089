# Fichier de projet Jenga pour exo13 - journal des événements (Win32 pur)
from Jenga import *
from Jenga.GlobalToolchains import RegisterJengaGlobalToolchains

with workspace("JournalEventsWks", location="."):
    RegisterJengaGlobalToolchains()
    configurations(["Debug", "Release"])
    targetoses([TargetOS.WINDOWS])
    targetarchs([TargetArch.X86_64])

    with project("JournalEvents"):
        windowedapp()
        language("C++")
        cppdialect("C++17")
        location(".")
        files(["src/**.cpp"])
        links(["user32", "gdi32"])
        usetoolchain("clang-mingw")